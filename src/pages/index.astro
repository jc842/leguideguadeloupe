---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site.config';
import ReviveSlot from '../components/ads/ReviveSlot.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft && (!data.lang || data.lang === 'fr'));
allPosts.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
const featuredPosts = allPosts.slice(0, 9);

const guidePillars = [
  { title: "Grande-Terre & Lagons", code: "GT-LAGOON-01", desc: "Plages de sable blanc, récifs coralliens protégés, spots de surf du Moule et falaises de la Pointe des Châteaux.", icon: "🏖️", link: "/blog/" },
  { title: "Basse-Terre & La Soufrière", code: "BT-VOLCANO-02", desc: "Parc National de la Guadeloupe, volcan actif culminant à 1467m, forêt primaire et cascades du Carbet.", icon: "🌋", link: "/blog/" },
  { title: "Les Îles du Sud & Dépendances", code: "ISLES-ARCHIPEL-03", desc: "La baie des Saintes classée UNESCO, l'authenticité de Marie-Galante et la réserve de La Désirade.", icon: "⛵", link: "/blog/" },
  { title: "Patrimoine & Distilleries", code: "HERITAGE-RHUM-04", desc: "Habitations coloniales, histoire du sucre, distilleries de rhum agricole pur jus de canne et musées.", icon: "🏛️", link: "/blog/" },
  { title: "Randonnées & Écotourisme", code: "HIKING-PARK-05", desc: "Sentiers de crêtes, traces côtières, bassins d'eau chaude thermale et plongée à la Réserve Cousteau.", icon: "🥾", link: "/blog/" },
  { title: "Saveurs & Gastronomie Créole", code: "KREYOL-FLAVORS-06", desc: "Marchés aux épices colorés, accras croustillants, colombo parfumé, bokits traditionnels et vanille.", icon: "🍲", link: "/blog/" },
];
---

<Layout title="Le Guide Guadeloupe — Communes, Plages, Patrimoine & Randonnées">
  <!-- Hero Section Lexington Quartiere Style -->
  <section class="relative overflow-hidden pt-12 pb-16 lg:py-24 border-b border-stone-200 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-stone-100 border border-stone-200 text-stone-800 text-xs font-mono font-medium tracking-wide uppercase mb-6">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>32 Communes • Archipel de la Guadeloupe • Guide Indépendant</span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-heading font-black text-stone-900 tracking-tight leading-[1.08] mb-6">
          EXPLORER LA GUADELOUPE DANS SES <span class="underline decoration-emerald-500 decoration-wavy underline-offset-8">MOINDRES DÉTAILS</span>.
        </h1>

        <p class="text-lg sm:text-xl text-stone-600 leading-relaxed font-normal mb-8">
          Le répertoire territorial et touristique de référence : 32 communes répertoriées, trésors cachés de Grande-Terre, Basse-Terre et des îles dépendantes, randonnées volcaniques et authenticité créole.
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a href="/blog/" class="px-6 py-3.5 rounded-lg bg-stone-900 text-white font-medium text-sm hover:bg-stone-800 transition-colors shadow-sm">
            Parcourir les 194 Dossiers &rarr;
          </a>
          <a href="#communes" class="px-6 py-3.5 rounded-lg border border-stone-300 text-stone-700 font-medium text-sm hover:bg-stone-50 transition-colors">
            Voir les Territoires
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- International Editions Hub (i18n) -->
  <section class="border-b border-stone-200 bg-stone-50 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/en/" class="group p-5 rounded-xl bg-white border border-stone-200 hover:border-emerald-500 transition-all flex items-center justify-between shadow-xs">
          <div>
            <div class="flex items-center space-x-2 mb-1">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-700">English Edition</span>
              <span class="text-[10px] bg-stone-100 text-stone-600 px-2 py-0.5 rounded border border-stone-200">EN</span>
            </div>
            <h3 class="text-base font-bold text-stone-900 group-hover:text-emerald-700 transition-colors">
              Guadeloupe Island Travel Guide: 32 Communes, Beaches & Volcano Trails
            </h3>
            <p class="text-xs text-stone-500 mt-1">
              Comprehensive traveler manual, ferry hopping to Les Saintes, and coastal maps.
            </p>
          </div>
          <span class="text-xl text-emerald-600 group-hover:translate-x-1 transition-transform ml-4">&rarr;</span>
        </a>

        <a href="/es/" class="group p-5 rounded-xl bg-white border border-stone-200 hover:border-emerald-500 transition-all flex items-center justify-between shadow-xs">
          <div>
            <div class="flex items-center space-x-2 mb-1">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-700">Edición en Español</span>
              <span class="text-[10px] bg-stone-100 text-stone-600 px-2 py-0.5 rounded border border-stone-200">ES</span>
            </div>
            <h3 class="text-base font-bold text-stone-900 group-hover:text-emerald-700 transition-colors">
              Guía Completa de Guadalupe: Naturaleza, Playas, Comunas y Volcán
            </h3>
            <p class="text-xs text-stone-500 mt-1">
              Información detallada para recorrer Grande-Terre, Basse-Terre y las islas satélites.
            </p>
          </div>
          <span class="text-xl text-emerald-600 group-hover:translate-x-1 transition-transform ml-4">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Territoires & Piliers du Guide (Quartiere Bento) -->
  <section id="communes" class="py-16 border-b border-stone-200 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-emerald-700 font-bold block mb-2">Structure du Guide</span>
          <h2 class="text-2xl sm:text-4xl font-heading font-black text-stone-900 tracking-tight">
            6 Piliers d'Exploration Insulaire
          </h2>
        </div>
        <p class="text-sm text-stone-500 max-w-md mt-4 md:mt-0">
          Chaque commune et chaque micro-région passées au crible pour vous offrir une vision d'ensemble complète et documentée.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {guidePillars.map(pillar => (
          <div class="p-6 rounded-xl border border-stone-200 bg-stone-50/50 hover:bg-white hover:border-emerald-500 transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-2xl">{pillar.icon}</span>
                <span class="text-[11px] font-mono font-medium text-stone-400 bg-white px-2 py-0.5 rounded border border-stone-200">{pillar.code}</span>
              </div>
              <h3 class="text-lg font-bold text-stone-900 mb-2">{pillar.title}</h3>
              <p class="text-xs text-stone-600 leading-relaxed">{pillar.desc}</p>
            </div>
            <div class="mt-6 pt-4 border-t border-stone-200 flex items-center justify-between text-xs font-semibold text-emerald-700">
              <a href={pillar.link} class="hover:underline">Consulter les dossiers &rarr;</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Articles Récents & Guides -->
  <section class="py-16 bg-stone-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8 border-b border-stone-200 pb-4">
        <div>
          <h2 class="text-2xl font-black text-stone-900 tracking-tight">Guides & Articles Récents</h2>
          <p class="text-xs text-stone-500 mt-1">Les dernières enquêtes et fiches pratiques publiées sur l'archipel.</p>
        </div>
        <a href="/blog/" class="text-xs font-bold text-emerald-700 hover:text-emerald-800 transition-colors uppercase tracking-wider">
          Tous les articles ({allPosts.length}) &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featuredPosts.map(post => (
          <article class="p-5 rounded-xl bg-white border border-stone-200 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
            <div>
              <span class="text-[11px] font-mono font-semibold uppercase text-emerald-700 block mb-2">{post.data.category || 'Guide'}</span>
              <h3 class="text-base font-bold text-stone-900 hover:text-emerald-700 transition-colors line-clamp-2 mb-2">
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h3>
              <p class="text-xs text-stone-500 line-clamp-3 leading-relaxed mb-4">{post.data.description}</p>
            </div>
            <div class="pt-3 border-t border-stone-100 flex items-center justify-between text-[11px] text-stone-400">
              <span>{new Date(post.data.pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
              <a href={`/blog/${post.id}/`} class="text-emerald-700 font-semibold hover:underline">Lire la suite &rarr;</a>
            </div>
          </article>
        ))}
      </div>

      <!-- Revive In-Content Slot -->
      {siteConfig.revive?.zones?.inContent && (
        <div class="my-10 flex justify-center">
          <ReviveSlot format={siteConfig.revive.zones.inContent.format} zoneId={siteConfig.revive.zones.inContent.zoneId} />
        </div>
      )}
    </div>
  </section>
</Layout>
